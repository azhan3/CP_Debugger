{
  "name": "cp-debugger",
  "displayName": "CP Debugger",
  "description": "CP Debugger visualizer inside VS Code",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:cpDebugger.open",
    "onCommand:cpDebugger.refresh",
    "onView:cpDebugger.sessions"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cpDebugger.open",
        "title": "CP Debugger: Open Panel"
      },
      {
        "command": "cpDebugger.refresh",
        "title": "CP Debugger: Refresh"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cpDebugger",
          "title": "CP Debugger",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cpDebugger": [
        {
          "id": "cpDebugger.sessions",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "CP Debugger",
      "properties": {
        "cpDebugger.mode": {
          "type": "string",
          "enum": ["file", "http"],
          "default": "file",
          "description": "Select session ingestion mode."
        },
        "cpDebugger.sessionFile": {
          "type": "string",
          "default": "${workspaceFolder}/debug_output.json",
          "description": "Path to the debug session JSON file."
        },
        "cpDebugger.httpEndpoint": {
          "type": "string",
          "default": "http://localhost:3000/api/debug",
          "description": "HTTP endpoint for fetching sessions in http mode."
        },
        "cpDebugger.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh when data changes."
        },
        "cpDebugger.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "description": "Polling interval for HTTP mode in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
